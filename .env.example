NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only (Vercel env vars, never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Krontiva Hub integration — value must match the PIPEE_HUB_SECRET registered
# in Hub's own env (supabase/seed_registry.sql: secret_ref for product 'pipee')
PIPEE_HUB_SECRET=<hub-issued-secret>
# Guards /api/cron/hub-sync — same convention as Hub's own CRON_SECRET
CRON_SECRET=<cron-secret>
# Base URL used to build the url field Hub links back to. Defaults to
# https://pipee.vercel.app (the URL registered in Hub's product registry).
PIPEE_PUBLIC_URL=https://pipee.vercel.app
